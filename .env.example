# Browser configuration: Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only credentials: Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email, and private_key from that JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# Server-only PDF download notifications (recipient is always fazahomeae@gmail.com).
# For Gmail, use an app password, not your regular sign-in password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=fazahomeae@gmail.com
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER; must be a sender allowed by your provider.
SMTP_FROM=
